# ---- Stage 1 : build des dépendances ----
FROM python:3.12-slim AS builder

WORKDIR /build

COPY requirements-api.txt .
RUN pip install --no-cache-dir --user -r requirements-api.txt

# ---- Stage 2 : image finale, légère ----
FROM python:3.12-slim

# Utilisateur non-root pour l'exécution de l'application
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# On récupère uniquement les packages déjà installés du stage précédent
COPY --from=builder /root/.local /home/appuser/.local

# Code applicatif et modèle entraîné
COPY api/ ./api/
COPY models/ ./models/

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]